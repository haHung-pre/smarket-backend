# ============================================================
# S MARKET BACKEND — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB — replace with your Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smarket?retryWrites=true&w=majority

# JWT Secret — change this to a long random string
JWT_SECRET=smarket_ha_hung_super_secret_key_change_this_2024

# JWT Expiry
JWT_EXPIRES_IN=7d

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=https://httpsmarket.blogspot.com,http://localhost:3000,http://localhost:5000

# Admin default account (used by seed script)
ADMIN_EMAIL=admin@smarket.vn
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Hà Hùng
